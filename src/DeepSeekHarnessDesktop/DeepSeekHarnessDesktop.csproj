<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>DeepSeekHarnessDesktop</AssemblyName>
    <RootNamespace>DeepSeekHarnessDesktop</RootNamespace>
    <AssemblyTitle>DeepSeek Harness Desktop</AssemblyTitle>
    <Product>DeepSeek Harness Desktop</Product>
    <Description>Windows desktop host for DeepSeek Harness Web UI</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Compatibility\NetFrameworkCompatibility.cs"
             Link="Compatibility\NetFrameworkCompatibility.cs" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Memory" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\VERSION_HISTORY.md"
                      Link="Resources\VERSION_HISTORY.md"
                      LogicalName="DeepSeekHarnessDesktop.VERSION_HISTORY.md" />
    <Content Include="..\..\eng\dsh-runtime\package.json"
             Link="dsh-runtime\package.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\eng\dsh-runtime\package-lock.json"
             Link="dsh-runtime\package-lock.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
