<Window x:Class="DeepSeekHarnessDesktop.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH 启动日志"
        Width="920"
        Height="560"
        MinWidth="640"
        MinHeight="360"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock Margin="2,0,0,10" FontSize="16" FontWeight="SemiBold" Text="最近 1,000 行" />
    <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding RecentLogs}" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock TextWrapping="NoWrap">
            <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" />
            <Run Text="  " />
            <Run Text="{Binding Source}" />
            <Run Text="  " />
            <Run Text="{Binding Text}" />
          </TextBlock>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
