<UserControl x:Class="DeepSeekHarnessDesktop.Views.InstallationGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="准备 DeepSeek Harness" />
      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding CurrentStage}" />
        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ElapsedText}" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Margin="0,8,0,14" Foreground="{StaticResource MutedTextBrush}"
               TextWrapping="Wrap" Text="{Binding StageMessage}" />

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="1.25*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock FontWeight="SemiBold" Text="1  WebView2" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding WebView2StatusText}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,16,0">
        <TextBlock FontWeight="SemiBold" Text="2  Node.js" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding NodeStatusText}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,16,0">
        <TextBlock FontWeight="SemiBold" Text="3  npx" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding NpxStatusText}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock FontWeight="SemiBold" Text="4  DSH" />
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding DshStatusText}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="3" Grid.RowSpan="2" MinHeight="120" Margin="0,0,0,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="#FAFAFA" Padding="8">
      <ListBox x:Name="InstallLogList" ItemsSource="{Binding RecentLogs}" BorderThickness="0" Background="Transparent"
               FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.ScrollChanged="OnLogScrollChanged" AutomationProperties.Name="DSH 安装过程日志">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="5" Margin="0,12,0,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <WrapPanel>
        <Button Command="{Binding OpenDocumentationCommand}" Content="DSH 文档" ToolTip="打开 DSH 官方文档" AutomationProperties.Name="打开 DSH 官方文档" />
        <Button Command="{Binding CopyLogsCommand}" Content="复制日志" ToolTip="复制已经脱敏的安装日志" AutomationProperties.Name="复制安装日志" />
      </WrapPanel>
      <Grid Grid.Row="1" Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button HorizontalAlignment="Left" Command="{Binding RecheckCommand}" Content="重新检查" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Command="{Binding CloseCommand}" Content="返回" />
          <Button Command="{Binding CancelCommand}" Content="取消" />
          <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding DownloadAndStartCommand}" Content="{Binding PrimaryActionText}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
