<Window x:Class="DeepSeekHarnessDesktop.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 账号"
        Width="680"
        Height="630"
        MinWidth="600"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="52" />
    </Grid.RowDefinitions>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <StackPanel Margin="20,0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="18"
                   Foreground="{StaticResource AccentBrush}"
                   Text="&#xE77B;" />
        <TextBlock Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="DeepSeek 账号" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,20">
        <TextBlock FontSize="13" FontWeight="SemiBold" Text="API 凭据" />
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <PasswordBox x:Name="ApiKeyBox"
                       Height="34"
                       Padding="9,5"
                       VerticalContentAlignment="Center"
                       AutomationProperties.Name="DeepSeek API Key" />
          <Button Grid.Column="1"
                  Margin="8,0,0,0"
                  Click="OnRefreshClick"
                  Content="查询余额">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Grid.Column="2"
                  Style="{StaticResource ToolbarIconButtonStyle}"
                  Margin="6,1,0,1"
                  Click="OnClearApiKeyClick"
                  Content="&#xE74D;"
                  ToolTip="清除 API Key"
                  AutomationProperties.Name="清除 API Key" />
        </Grid>
        <TextBlock Margin="0,7,0,0"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="可选。留空时自动读取 Harness 当前使用的 DeepSeek API Key；手工输入仅覆盖本次查询。" />

        <Border Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
        <TextBlock Margin="0,18,0,0" FontSize="13" FontWeight="SemiBold" Text="账户状态" />
        <Grid Margin="0,11,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Foreground="{StaticResource MutedTextBrush}" Text="连接" />
          <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding StatusText}" />
          <TextBlock Grid.Row="1" Margin="0,9,0,0" Foreground="{StaticResource MutedTextBrush}" Text="API Key" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,9,0,0" Text="{Binding MaskedApiKey}" />
          <TextBlock Grid.Row="2" Margin="0,9,0,0" Foreground="{StaticResource MutedTextBrush}" Text="更新时间" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,9,0,0" Text="{Binding LastUpdatedText}" />
        </Grid>
        <TextBlock Margin="0,10,0,0"
                   Foreground="#B42318"
                   Text="{Binding ErrorText}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
        <DockPanel Margin="0,18,0,0">
          <TextBlock DockPanel.Dock="Right"
                     FontSize="12"
                     Foreground="{StaticResource MutedTextBrush}"
                     Text="{Binding AvailabilityText}" />
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="账户余额" />
        </DockPanel>
        <ListView Margin="0,10,0,0"
                  MinHeight="86"
                  BorderBrush="{StaticResource BorderBrush}"
                  ItemsSource="{Binding Balances}">
          <ListView.View>
            <GridView AllowsColumnReorder="False">
              <GridViewColumn Header="币种" Width="92" DisplayMemberBinding="{Binding Currency}" />
              <GridViewColumn Header="总余额" Width="140" DisplayMemberBinding="{Binding TotalBalance, StringFormat={}{0:N2}}" />
              <GridViewColumn Header="赠送余额" Width="140" DisplayMemberBinding="{Binding GrantedBalance, StringFormat={}{0:N2}}" />
              <GridViewColumn Header="充值余额" Width="140" DisplayMemberBinding="{Binding ToppedUpBalance, StringFormat={}{0:N2}}" />
            </GridView>
          </ListView.View>
        </ListView>

        <Border Margin="0,20,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
        <TextBlock Margin="0,18,0,0" FontSize="13" FontWeight="SemiBold" Text="Token 使用统计" />
        <TextBlock Margin="0,8,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   LineHeight="21"
                   TextWrapping="Wrap"
                   Text="DeepSeek 官方 API 当前未提供账户级历史 Token 统计。Token 用量只随每次模型响应的 usage 返回，本应用不会读取或推算 DSH 内部请求。" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <DockPanel Margin="18,9">
        <Button DockPanel.Dock="Right" MinWidth="82" Click="OnCloseClick" Content="关闭" />
        <ProgressBar Width="120"
                     Height="3"
                     IsIndeterminate="True"
                     VerticalAlignment="Center"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
