<UserControl x:Class="DeepSeekHarnessDesktop.Views.States.StartingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <StackPanel Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
      <ProgressBar Height="4" IsIndeterminate="True" />
      <TextBlock Margin="0,24,0,8" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
      <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusDetail}" />
    </StackPanel>
  </Grid>
</UserControl>
