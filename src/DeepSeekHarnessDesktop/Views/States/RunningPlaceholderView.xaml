<UserControl x:Class="DeepSeekHarnessDesktop.Views.States.RunningPlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="#FAFBFC">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Width="48" Height="48" CornerRadius="4" Background="{StaticResource AccentBrush}">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="White" Text="D" />
      </Border>
      <TextBlock Margin="0,18,0,8" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
      <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="服务身份已确认；阶段 4 将在此加载官方 Web UI" />
      <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="{Binding ServiceUri}" />
    </StackPanel>
  </Grid>
</UserControl>
